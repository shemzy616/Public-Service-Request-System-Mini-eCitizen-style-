# ═══════════════════════════════════════════════════════════════════════════════
# HUDUMA MURANG'A — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# County 021 | Murang'a County Government
# Copy this file to .env and configure the values for your local environment:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# Flask Session Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-2026

# Live Gmail SMTP Configuration (For OTP Password Resets & Ticket Resolution Alerts)
# NOTE: Requires a Google 16-character App Password (not your personal account password).
# See: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-county-service-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Murang'a County Citizen Helpline
HELPLINE_NUMBER=0119706796

# SQLite Database Filename / Path
DATABASE_URL=portal.db
